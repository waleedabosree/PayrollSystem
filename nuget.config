<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Drops any machine-level or user-level feeds (this environment had
         unrelated TFS feeds configured that caused -404s and restore noise). -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>