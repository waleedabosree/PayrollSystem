{
  "ConnectionStrings": {
    "PayrollDb": ""
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "Storage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "payroll-uploads"
  },
  "ServiceBus": {
    "ConnectionString": "",
    "QueueName": "payroll-jobs"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Payroll": {
    "MaxFileSizeBytes": 10485760,
    "MaxRows": 100000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*"
}